#!/usr/bin/env bash
# git pre-push hook: refuses a push unless scripts/scan-public.sh prints 0 for every pushed tree and for the
# patches and messages of the commits being pushed. Install once per checkout:
#   ln -s ../../scripts/pre-push .git/hooks/pre-push
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _ remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  work="$(mktemp -d)"
  git -C "$ROOT" archive "$local_sha" | tar -x -C "$work"
  if [[ "$remote_sha" == "$ZERO" ]]; then range="$(git -C "$ROOT" merge-base "$local_sha" origin/main 2>/dev/null)..$local_sha"
  else range="$remote_sha..$local_sha"; fi
  git -C "$ROOT" log -p --format='%an <%ae>%n%B' "$range" > "$work/.pushed-commits.txt"
  if ! bash "$ROOT/scripts/scan-public.sh" "$work" > "$work.scan" 2>&1; then
    cat "$work.scan" >&2
    echo "pre-push: leak scan is not 0 for ${local_sha:0:7}; push refused" >&2
    status=1
  fi
  rm -rf "$work" "$work.scan"
done
exit "$status"
