#!/usr/bin/env bash
# git pre-push hook: refuses a push unless scripts/scan-public.sh prints 0 for every pushed tree and for the
# messages and the added lines of the patches of the commits being pushed. A removed line is left out: it is
# already public, or an earlier pushed commit added it and that commit's patch is scanned, so a commit that
# takes a leaked line out of main is not refused for it. Install once per checkout:
#   ln -s ../../scripts/pre-push .git/hooks/pre-push
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  # Trust actual destination branch heads, not local tracking refs.
  if ! remote_heads="$(git -C "$ROOT" ls-remote "$2" 'refs/heads/*' 2>/dev/null)"; then
    echo "pre-push: cannot read remote main; fetch origin main first; push refused" >&2
    status=1
    continue
  fi
  remote_main="$(awk '$2 == "refs/heads/main" { print $1 }' <<< "$remote_heads")"
  if [[ -z "$remote_main" ]] ||
    ! git -C "$ROOT" cat-file -e "$remote_main^{commit}" 2>/dev/null; then
    echo "pre-push: remote main commit is not available locally; fetch origin main first; push refused" >&2
    status=1
    continue
  fi
  if ! git -C "$ROOT" merge-base "$local_sha" "$remote_main" >/dev/null; then
    echo "pre-push: branch is not based on remote main; push refused" >&2
    status=1
    continue
  fi
  exclude=()
  while read -r sha ref; do
    [[ "$ref" == refs/heads/* ]] || continue
    if git -C "$ROOT" cat-file -e "$sha^{commit}" 2>/dev/null; then
      exclude+=("$sha")
    fi
  done <<< "$remote_heads"
  work="$(mktemp -d)"
  if ! git -C "$ROOT" archive "$local_sha" | tar -x -C "$work"; then
    echo "pre-push: cannot export pushed tree; push refused" >&2
    status=1
    rm -rf "$work"
    continue
  fi
  if ! git -C "$ROOT" log --format='%an <%ae>%n%cn <%ce>%n%B' "$local_sha" --not "${exclude[@]}" > "$work/.pushed-commits.txt" ||
    ! git -C "$ROOT" log -p --format= "$local_sha" --not "${exclude[@]}" > "$work.patches" ||
    ! { grep -v '^-' "$work.patches" > "$work/.pushed-patches.txt" || [[ $? == 1 ]]; }; then
    echo "pre-push: cannot read pushed commit history; push refused" >&2
    status=1
    rm -rf "$work" "$work.patches"
    continue
  fi
  rm -f "$work.patches"
  if ! bash "$ROOT/scripts/scan-public.sh" "$work" > "$work.scan" 2>&1; then
    cat "$work.scan" >&2
    echo "pre-push: leak scan is not 0 for ${local_sha:0:7}; push refused" >&2
    status=1
  fi
  rm -rf "$work" "$work.scan"
done
exit "$status"
