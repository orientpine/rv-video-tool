#!/usr/bin/env bash
# git pre-push hook: refuses a push unless scripts/scan-public.sh prints 0 for every pushed tree and for the
# patches and messages of the commits being pushed. Install once per checkout:
#   ln -s ../../scripts/pre-push .git/hooks/pre-push
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  # After a rebase, a range from the old remote tip includes unrelated main commits.
  # Trust the destination's main, not a possibly stale local tracking ref.
  if ! remote_main="$(git -C "$ROOT" ls-remote "$2" refs/heads/main 2>/dev/null |
    awk '$2 == "refs/heads/main" { print $1 }')" ||
    [[ -z "$remote_main" ]]; then
    echo "pre-push: cannot read remote main; fetch origin main first; push refused" >&2
    status=1
    continue
  fi
  if ! git -C "$ROOT" cat-file -e "$remote_main^{commit}" 2>/dev/null; then
    echo "pre-push: remote main commit is not available locally; fetch origin main first; push refused" >&2
    status=1
    continue
  fi
  if ! base="$(git -C "$ROOT" merge-base "$local_sha" "$remote_main")"; then
    echo "pre-push: branch is not based on remote main; push refused" >&2
    status=1
    continue
  fi
  range="$base..$local_sha"
  work="$(mktemp -d)"
  git -C "$ROOT" archive "$local_sha" | tar -x -C "$work"
  git -C "$ROOT" log -p --format='%an <%ae>%n%cn <%ce>%n%B' "$range" > "$work/.pushed-commits.txt"
  if ! bash "$ROOT/scripts/scan-public.sh" "$work" > "$work.scan" 2>&1; then
    cat "$work.scan" >&2
    echo "pre-push: leak scan is not 0 for ${local_sha:0:7}; push refused" >&2
    status=1
  fi
  rm -rf "$work" "$work.scan"
done
exit "$status"
