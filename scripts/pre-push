#!/usr/bin/env bash
# git pre-push hook: refuses a push unless scripts/scan-public.sh prints 0 for every pushed tree and for the
# patches and messages of the commits being pushed. Install once per checkout:
#   ln -s ../../scripts/pre-push .git/hooks/pre-push
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  # After a rebase, a range from the old remote tip includes unrelated main commits.
  # Use the branch's base on main for both existing and new remote branches.
  if ! base="$(git -C "$ROOT" merge-base "$local_sha" origin/main)"; then
    echo "pre-push: cannot find merge-base with origin/main; push refused" >&2
    status=1
    continue
  fi
  range="$base..$local_sha"
  work="$(mktemp -d)"
  git -C "$ROOT" archive "$local_sha" | tar -x -C "$work"
  git -C "$ROOT" log -p --format='%an <%ae>%n%cn <%ce>%n%B' "$range" > "$work/.pushed-commits.txt"
  if ! bash "$ROOT/scripts/scan-public.sh" "$work" > "$work.scan" 2>&1; then
    cat "$work.scan" >&2
    echo "pre-push: leak scan is not 0 for ${local_sha:0:7}; push refused" >&2
    status=1
  fi
  rm -rf "$work" "$work.scan"
done
exit "$status"
