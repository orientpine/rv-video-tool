    {"scene": "bottle", "text": "A hand goal connects the person to a real object.", "keywords": ["goal"]},
    {"scene": "bottle", "text": "She puts the bottle on the shelf above her shoulder.", "keywords": ["puts", "shelf"]},
    {"scene": "bottle", "text": "The palm follows the bottle until contact, then lets go."},
    {"scene": "bottle", "text": "It rests."},
    {"scene": "handle", "text": "Here the person approaches a cabinet.", "keywords": ["approaches"]},
    {"scene": "handle", "text": "She grips the handle with her palm clear of the cabinet.", "keywords": ["grips"]},
    {"scene": "handle", "text": "After release, the door opens on its hinge.", "keywords": ["release", "opens"]},
    {"scene": "handle", "text": "All clear."},
    {"scene": "wheelchair", "text": "The rider sits on the cushion with feet on the footrest.", "keywords": ["cushion"]},
    {"scene": "wheelchair", "text": "He grips the push rims with both hands.", "keywords": ["grips"]},
    {"scene": "wheelchair", "text": "The wheels turn gently beneath the steady hands.", "keywords": ["turn"]},
    {"scene": "wheelchair", "text": "Ready."}
